NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tanjil_identity
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
APP_URL=http://localhost:3000

# Optional owner bootstrap. Set these only in your local .env or deployment secret store.
# Never commit real account credentials here. If the username is not registered yet,
# provide ADMIN_EMAIL and an ADMIN_PASSWORD of at least 12 characters.
ADMIN_USERNAME=owner.4x
ADMIN_PASSWORD=123456789011121314
ADMIN_EMAIL=owner@gmail.com
